#!/usr/bin/env bash
# The AMI survey procedure and tool schemas, packaged for any runtime.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# $HERE holds ami_survey; its parent holds amitransport, which the
# collector needs to seal a submission. Both, so an import of either
# resolves the same way here and in the published client.
export PYTHONPATH="$HERE:$HERE/..${PYTHONPATH:+:$PYTHONPATH}"
exec "${AMI_PYTHON:-python3}" -m ami_survey.instructions "$@"
